# YouTube Enhance 与 DualSubs（gholts） - Anywhere MITM RuleSet
# 上游: gholts/surge、DualSubs/YouTube、DualSubs/Universal。

name = YouTube Enhance 与 DualSubs
icon-light = 
hostname = googlevideo.com, youtubei.googleapis.com, www.youtube.com, m.youtube.com, tv.youtube.com, s.youtube.com

[Parameter]
1, 0, blockUpload, 隐藏上传入口, 隐藏导航中的上传入口, true, "[true, false]"
1, 0, blockShorts, 隐藏Shorts入口, 隐藏导航中的Shorts入口, false, "[true, false]"
1, 0, autoHd, 自动高清, 优先最高可用视频清晰度并防止自动降级, true, "[true, false]"
1, 0, blockGames, 隐藏游戏推荐, 隐藏Playables游戏推荐卡片, true, "[true, false]"
1, 0, blockVerticalLive, 隐藏竖屏直播, 隐藏已识别的竖屏直播推荐, false, "[true, false]"
1, 0, jumpAhead, 启用Jump Ahead, 启用原生跳过按钮并去除推广提示, true, "[true, false]"
1, 0, blockStore, 隐藏商店与购物, 隐藏创作者商店和视频购物组件, true, "[true, false]"
1, 0, subtitle_type, [字幕] 启用类型, 请选择要使用的字幕，双语字幕将使用您选择类型呈现。, Translate, "[Translate, Official]"
1, 0, auto_cc, [字幕] 自动显示, 是否总是自动开启字幕显示。, true, "[true, false]"
1, 0, show_only_auto_translation, [翻译器] 只显示自动翻译字幕, 是否仅显示自动翻译字幕，不显示源语言字幕。, false, "[false, true]"

[Rule]
0, 0, ^https?://[\w-]+\.googlevideo\.com/initplayback(\?.*oad=.+)$, 3
0, 0, ^https://www\.youtube\.com/(pagead|pcs)/, 2,
0, 0, ^https://s\.youtube\.com/api/stats/ads, 2,
0, 100, ^https://youtubei\.googleapis\.com/youtubei/v1/player/ad_break(?:\?.*)?$, ZnVuY3Rpb24gcHJvY2VzcyhjdHgpe2lmKGN0eC5waGFzZT09PSJyZXF1ZXN0IilBbnl3aGVyZS5yZXNwb25kKHtzdGF0dXM6MjAwLGhlYWRlcnM6W1siQ29udGVudC1UeXBlIiwiYXBwbGljYXRpb24veC1wcm90b2J1ZiJdXSxib2R5Om5ldyBVaW50OEFycmF5KCl9KTt9
0, 100, ^https?://[\w-]+\.googlevideo\.com/(?:initplayback|videoplayback)(?:\?.*)?$, 
0, 100, ^https://youtubei\.googleapis\.com/youtubei/v1/log_event(?:\?.*)?$, 
0, 100, ^https://(?:(?:www|m|tv)\.youtube\.com|youtubei\.googleapis\.com)/youtubei/v1/(?:player|get_watch)(?:\?|$), 
1, 100, ^https://youtubei\.googleapis\.com/youtubei/v1/(?:navigation/resolve_url|browse|next|player|search|reel/reel_watch_sequence|guide|account/get_setting|get_watch)(?:\?.*)?$, 
1, 100, ^https://youtubei\.googleapis\.com/youtubei/v1/(?:config|log_event)(?:\?.*)?$, 
1, 100, ^(?=[\s\S]*/youtubei/v1/(?:player|get_watch)(?:\?|$))https://youtubei\.googleapis\.com/youtubei/v1/(?:navigation/resolve_url|browse|next|player|search|reel/reel_watch_sequence|guide|account/get_setting|get_watch)(?:\?.*)?$, 
1, 100, ^https://(?:www|m|tv)\.youtube\.com/youtubei/v1/(?:player|get_watch)(?:\?|$), 
1, 100, ^https?://[\w-]+\.googlevideo\.com/initplayback(?:\?.*)?$, 
