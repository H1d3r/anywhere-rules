# Anywhere runtime: 2.1 (347) / 4bc9ed2d
# randomRadius 使用上游球面圆盘扰动；0 关闭。在线选点持久化值优先于参数，未配置坐标时透传。
# 静态专用脚本；无兼容层、运行时 eval、源码缓存、外部 HTTP 或无界 store。

name = Apple WLOC 定位修改 Arg
hostname = gs-loc.apple.com, gs-loc-cn.apple.com

[Parameter]
0, 0, longitude, 经度, 默认经度。在线选点保存的坐标优先于此参数。, 113.94114
0, 0, latitude, 纬度, 默认纬度。在线选点保存的坐标优先于此参数。, 22.544577
0, 0, accuracy, 精度, 定位精度，单位米。, 25
0, 0, randomRadius, 扰动半径, 每次响应在目标点周围随机偏移的最大距离，单位米；0 为关闭。, 0
1, 0, logLevel, 日志级别, 上游 wloc 日志级别。, info, "[info, off, error, warn, debug, all]"

[Rule]
0, 100, ^https?://gs-loc(-cn)?\.apple\.com/wloc-settings/save(?:\?|$), 
1, 100, ^https?://gs-loc(-cn)?\.apple\.com/clls/wloc(?:\?|$), 
