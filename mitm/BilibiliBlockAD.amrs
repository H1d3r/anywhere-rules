# Bilibili 去广告 - Anywhere MITM RuleSet
# 上游版本: kokoryh/Sparkle 11002969 (2026-08-09)。
# 新增: AI 推荐 AIRelateAsync 去广告；同步活动页 H5Slider 广告隐藏修复。
# 保留: 原生 splash/list mock、直播 tracker 固定域名、iPad RelatesFeed、活动页外链广告隐藏。
# 保留: 已验证的完整 protobuf response 清理与参数；空降助手/SponsorBlock 继续排除。
# 注意: 上游按请求头条件补 grpc-status 的行为无法由 Anywhere 静态 header 完全等价表达，待实机观察。
# 上游: kokoryh/Sparkle + kokoryh/Script。

name = Bilibili去广告
icon-light = 
hostname = grpc.biliapi.net, app.bilibili.com, api.bilibili.com, api.live.bilibili.com, line3-h5-mobile-api.biligame.com, www.bilibili.com

[Parameter]
1, 0, display_up_list, "[动态] UP 列表", "还原上游 displayUpList，可控制动态页顶部 UP 列表展示方式。", show, "[show, auto, hide]"
1, 0, purify_comment, "[评论] 净化评论", 过滤评论区广告卡片和常见引流内容。, true, "[true, false]"
1, 0, log_level, "[调试] 日志等级", "选择上游 protobuf 脚本日志等级。", error, "[error, off, warn, info, debug]"

[Rule]

0, 0, ^https://app\.bilibili\.com/x/v2/splash/list(?:\?|$), 2, "{""code"":0,""message"":""OK"",""ttl"":1,""data"":{""max_time"":0,""min_interval"":31536000,""pull_interval"":31536000,""keep_ids"":[],""show"":[],""list"":[{}],""splash_request_id"":""""}}"

0, 2, ^https://grpc\.biliapi\.net/bilibili\.app\.(?:interface\.v1\.(?:Teenagers/ModeStatus|Search/DefaultWords)|view\.v1\.View/TFInfo|viewunite\.v1\.View/(?:PlayPause|ViewEndPage))(?:\?|$), grpc-accept-encoding
0, 1, ^https://grpc\.biliapi\.net/bilibili\.app\.(?:interface\.v1\.(?:Teenagers/ModeStatus|Search/DefaultWords)|view\.v1\.View/TFInfo|viewunite\.v1\.View/(?:PlayPause|ViewEndPage))(?:\?|$), grpc-accept-encoding, identity
0, 2, ^https://grpc\.biliapi\.net/bilibili\.app\.(?:interface\.v1\.(?:Teenagers/ModeStatus|Search/DefaultWords)|view\.v1\.View/TFInfo|viewunite\.v1\.View/(?:PlayPause|ViewEndPage))(?:\?|$), grpc-encoding
0, 1, ^https://grpc\.biliapi\.net/bilibili\.app\.(?:interface\.v1\.(?:Teenagers/ModeStatus|Search/DefaultWords)|view\.v1\.View/TFInfo|viewunite\.v1\.View/(?:PlayPause|ViewEndPage))(?:\?|$), grpc-encoding, identity
0, 0, ^https://[^/]+/x/(?:resource/(?:top/activity|patch/tab(?:/v2)?)|v2/search/square|vip/ads/materials)(?:\?|$), 2, "{""code"":-404,""message"":""-404"",""ttl"":1,""data"":null}"
0, 0, ^https://[^/]+/pgc/activity/deliver/material/receive(?:\?|$), 2, "{""code"":0,""data"":{""closeType"":""close_win"",""container"":[],""showTime"":""""},""message"":""success""}"
0, 0, ^https://[^/]+/xlive/e-commerce-interface/v1/ecommerce-user/get_shopping_info(?:\?|$), 2, {}
0, 0, ^https://[^/]+/game/live/large_card_material(?:\?|$), 2, "{""code"":0,""message"":""success""}"
1, 5, ^https://[^/]+/x/resource/show/tab/v2(?:\?|$), delete, $.data.splash
1, 5, ^https://[^/]+/x/resource/show/tab/v2(?:\?|$), delete, $.data.top_more
1, 5, ^https://[^/]+/pgc/view/v2/app/season(?:\?|$), delete, $.data.payment
1, 5, ^https://api\.live\.bilibili\.com/xlive/open-interface/v2/tracker/conf(?:\?|$), replace, $.data.domains, "[""wss://tracker.chat.bilibili.com""]"
1, 4, ^https://www\.bilibili\.com/blackboard/era/.+\.html\?, </head>, "<script>(()=>{const u=new Set(),h=[""EvaLayoutContainerPrerender"",""EvaLayoutContainer"",""EvaLinkButton"",""H5Slider""];function w(a,p=[]){for(const i of a||[]){const f=h.includes(i.name);if(f)p.push(i.uuid);const q=i.props||{},l=[q.jumpAddress,...((q.list||[]).map(x=>x.link))],x=i.name===""H5Slider""||l.some(v=>{try{return v&&!new URL(v).hostname.includes(""bilibili"")}catch(e){return false}});if(x)for(const id of p)u.add(id);for(const s of i.slots||[])if(s.children)w(s.children,p);if(f)p.pop()}}const t=window.__BILIACT_EVAPAGEDATA__&&window.__BILIACT_EVAPAGEDATA__.layerTree;if(!t)return;w(t);if(!u.size)return;const s=document.createElement(""style"");s.textContent=Array.from(u,x=>""#""+x+""{display:none!important}"").join("""");document.head.appendChild(s)})();</script></head>"
1, 1, ^https://grpc\.biliapi\.net/bilibili\.app\.(?:interface\.v1\.(?:Teenagers/ModeStatus|Search/DefaultWords)|view\.v1\.View/TFInfo|viewunite\.v1\.View/(?:PlayPause|ViewEndPage))(?:\?|$), grpc-status, 0
1, 100, ^https://grpc\.biliapi\.net/bilibili\.app\.(?:interface\.v1\.(?:Teenagers/ModeStatus|Search/DefaultWords)|view\.v1\.View/TFInfo|viewunite\.v1\.View/(?:PlayPause|ViewEndPage))(?:\?|$), 
1, 100, ^https://[^/]+/(?:pgc/page/channel|x/v2/splash/(?:show|event/list2)|x/resource/show/(?:tab/v2|skin)|x/v2/account/(?:mine(?:/ipad)?|myinfo)|xlive/(?:app-interface/v2/index/feed|app-room/v1/index/getInfoBy(?:Room|User))|x/pd-proxy/tracker)(?:\?|$), 
1, 100, ^https://[^/]+/x/v2/feed/index(?:/story)?(?:\?|$), 
1, 100, ^https://[^/]+/bilibili\.(?:app\.(?:show\.v1\.Popular/Index|dynamic\.v2\.Dynamic/DynAll|view(?:unite)?\.v1\.View/(?:View|ViewProgress|RelatesFeed|AIRelateAsync)|playurl\.v1\.PlayURL/PlayView|playerunite\.v1\.Player/PlayViewUnite)|polymer\.app\.search\.v1\.Search/SearchAll|community\.service\.dm\.v1\.DM/DmView|main\.community\.reply\.v1\.Reply/MainList|pgc\.gateway\.player\.v2\.PlayURL/PlayView)(?:\?|$),
